PORT=4000

# Postgres connection string. Leave empty in development to use the embedded Postgres
# (PGlite) stored in DATA_DIR/pglite. Required in production.
# DATABASE_URL=postgres://user:password@host:5432/shop
DATABASE_URL=

# Comma-separated origins allowed to call the API (the Next.js app). Must match exactly for login cookies to work
CORS_ORIGIN=http://localhost:3000
# Public URL of this API; used to build links to uploaded product images
PUBLIC_URL=http://localhost:4000
# Required to use the admin page. Generate one with: openssl rand -hex 32
ADMIN_TOKEN=
# Set to false in production to stop mixing synthetic demo shoppers into the model
SEED_DEMO_DATA=true
# Where the embedded dev database lives when DATABASE_URL is empty (default: backend/data)
# DATA_DIR=./data

# Optional: real product photos for the demo catalogue (`npm run seed:photos`)
# Create a free app at https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=
