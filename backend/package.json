{
  "name": "shop-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "dev:node": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start:node": "tsx --env-file-if-exists=.env src/index.ts",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "seed:images": "tsx scripts/demo-images.ts",
    "seed:photos": "tsx --env-file-if-exists=.env scripts/fetch-photos.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.17",
    "@elysiajs/cors": "^1.4.3",
    "@elysiajs/node": "^1.4.5",
    "elysia": "^1.4.32",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "@types/node": "^20",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
